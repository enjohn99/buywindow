# REQUIRED — GitHub is BuyWindow's canonical database
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=buywindow

# Optional GitHub/catalog settings
GITHUB_BRANCH=main
BUYWINDOW_REVIEW_ISSUES=true

# REQUIRED — live cross-retailer discovery
SERPAPI_API_KEY=

# Optional search defaults
BUYWINDOW_LOCATION=Austin, Texas
BUYWINDOW_GL=us
BUYWINDOW_HL=en

# Optional HTTP API settings
# Recommended for hosted deployments. Leave blank for unprotected local use.
BUYWINDOW_API_KEY=
PORT=8080

# Optional landed-cost settings
BUYWINDOW_TAX_MAX_RESULTS=10

# Optional product enrichment
# When true, listing images are downloaded and SHA-256 hashed for exact visual identity evidence.
BUYWINDOW_IMAGE_HASHING=false

# Optional eBay active resale-market evidence
# Both client ID and secret are required to enable this feature.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
