{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buywindow.dev/schemas/listing.schema.json",
  "title": "BuyWindow Retailer Listing",
  "type": "object",
  "required": [
    "listingId",
    "retailer",
    "source",
    "title",
    "observedAt"
  ],
  "properties": {
    "listingId": {
      "type": "string",
      "minLength": 1
    },
    "retailer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceProductId": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string"
    },
    "identifiers": {
      "type": "object"
    },
    "specifications": {
      "type": "object"
    },
    "packageContents": {
      "type": "array"
    },
    "imageEvidence": {
      "type": "array"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "offer": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0
        },
        "oldPrice": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "promotion": {
          "type": "string"
        },
        "shippingAmount": {
          "type": "number",
          "minimum": 0
        },
        "taxAmount": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
